  1119 0000495D C1E104              <1>     shl ecx, 4          ;Convert to bytes (max number of bytes in the block!)
  1120                              <1> ;Ensure we have a good environment, i.e. one that is double null terminated.
  1121 00004960 31C0                <1>     xor eax, eax
