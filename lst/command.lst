   872 00004780 48F7F3              <1>     div rbx         ;Divide rax by 10
   873 00004783 80C230              <1>     add dl, "0"     
   874 00004786 8817                <1>     mov byte [rdi], dl
   875 00004788 48FFC7              <1>     inc rdi
   876 0000478B FEC1                <1>     inc cl          ;Inc number of chars
   877 0000478D FEC5                <1>     inc ch          ;Inc to keep track of commas
   878 0000478F 4885C0              <1>     test rax, rax
   879 00004792 75CC                <1>     jnz .lp
