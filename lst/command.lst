   727                              <1> cpDelimPathToBufz:
   728                              <1> ;Copy a delimited path into buffer and null terminate.
   729                              <1> ;Input: rsi -> Point to start of delimiter terminated path
   730                              <1> ;       rdi -> Buffer to store null terminated path in
   731                              <1> ;Output: rsi -> First char past pathname delimiter
   732                              <1> ;       rdi -> One char past null terminator on pathname buffer
   733 000046AF 53                  <1>     push rbx
   734 000046B0 4889FB              <1>     mov rbx, rdi    ;Save the head of the path in rbx
   735 000046B3 C60700              <1>     mov byte [rdi], 0   ;Null terminate this path before starting!
   736                              <1> .lp:
   737 000046B6 AC                  <1>     lodsb   ;Get the char
   738 000046B7 3C0D                <1>     cmp al, CR
   739 000046B9 7412                <1>     je .gotRedirPath
   740 000046BB E8CCFEFFFF          <1>     call isALdelimiter  ;Is this char a delimiter char?
   741 000046C0 740B                <1>     jz .gotRedirPath 
   742 000046C2 3A0543B9FFFF        <1>     cmp al, byte [switchChar]
   743 000046C8 7403                <1>     je .gotRedirPath
   744 000046CA AA                  <1>     stosb   ;Store this char and loop next char
   745 000046CB EBE9                <1>     jmp short .lp
   746                              <1> .gotRedirPath:
   747 000046CD 50                  <1>     push rax    ;Save the char on stack
   748 000046CE 30C0                <1>     xor al, al  ;Get null terminator char
   749 000046D0 4829FB              <1>     sub rbx, rdi
   750 000046D3 4881FBFFFFFFFF      <1>     cmp rbx, -1 ;This is because one char has been written!!
   751 000046DA 7412                <1>     je .notColon
   752 000046DC 4881FBFEFFFFFF      <1>     cmp rbx, -2 ;This is for drive letters, must always have the colon!!
   753 000046E3 7409                <1>     je .notColon
   754 000046E5 807FFF3A            <1>     cmp byte [rdi - 1], ":" ;Is this a colon?
   755 000046E9 7503                <1>     jne .notColon
   756 000046EB 48FFCF              <1>     dec rdi     ;We overwrite the colon. 
   757                              <1> .notColon:
   758 000046EE AA                  <1>     stosb   ;Store the null terminator for the redir path
   759 000046EF 58                  <1>     pop rax ;Get back the char in al
   760 000046F0 5B                  <1>     pop rbx
   761                              <1>     return
    13                              <2> %%_ret:
    14 000046F1 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
