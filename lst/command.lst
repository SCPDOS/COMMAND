   495 00001A03 7213                <1>     jc .bad     ;If CF, always act as if EOF. An error occured.
   496 00001A05 85C0                <1>     test eax, eax   ;Here we check if we read 1 byte. (Clears CF)
   497 00001A07 7405                <1>     jz .eof         ;Jump to eofexit if we didn't read any bytes
   498 00001A09 803A1A              <1>     cmp byte [rdx], EOF ;Did we read ^Z char?
   499                              <1>     retne           ;Return if the char we read was not an EOF char
