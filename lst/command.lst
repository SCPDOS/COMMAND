   425                              <1> .htb1:
   426 000044C8 C1E104              <1>     shl ecx, 4  ;Move to upper nybble
   427 000044CB 08C8                <1>     or al, cl   ;Move upper nybble into al upper nybble
   428 000044CD 59                  <1>     pop rcx
   429 000044CE C3                  <1>     ret
