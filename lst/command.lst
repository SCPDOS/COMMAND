    33 00004B6E 6689C3              <1>     mov bx, ax  ;Save ah in bh and al in bl (if needed)
    34 00004B71 880595B4FFFF        <1>     mov byte [failDrv], al  ;Setup the failing drive (even on char as we reset)
    35 00004B77 488D15F0B5FFFF      <1>     lea rdx, crlf
    36 00004B7E E890F7FFFF          <1>     call printString    ;Trashes ax
    37 00004B83 0FB7FF              <1>     movzx edi, di                   ;Clear the upper word.
    38                              <1> 
    39 00004B86 53                  <1>     push rbx        ;Save the action bitfield
    40 00004B87 56                  <1>     push rsi        ;Save the driver pointer
