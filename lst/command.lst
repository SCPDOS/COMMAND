   431                              <1> printPackedBCD:
   432                              <1> ;Gets a packed BCD digit in al and prints al[7:4] if non zero,
   433                              <1> ; then prints al[3:0]. Prints a space if the upper nybble is zero
   434                              <1> ;Preserves all registers
   435 000044CF 50                  <1>     push rax
   436 000044D0 52                  <1>     push rdx
   437 000044D1 88C4                <1>     mov ah, al
   438 000044D3 240F                <1>     and al, 0Fh     ;Isolate lower nybble
   439 000044D5 80E4F0              <1>     and ah, 0F0h    ;Isolate upper nybble
   440 000044D8 7508                <1>     jnz .upperNybble
