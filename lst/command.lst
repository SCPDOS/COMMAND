  1089 0000273C 89C1                <1>     mov ecx, eax        ;Copy the flags
  1090 0000273E 81E110000000        <1>     and ecx, oneDest    ;Isolate for AND
  1091 00002744 743C                <1>     jz .sameNameExit    ;If not set, not in Concat mode
