   591                              <1> asciiFilenameToFCB:
   592                              <1> ;Converts a filename in the form FILENAME.EXT,0 to FILENAMEEXT
   593                              <1> ;Don't uppercase any lowercase chars as this could be used with user buffers.
   594                              <1> ;Also doesn't check if chars are valid
   595                              <1> ;Names such as SYS.COM get converted to "SYS     COM"
   596                              <1> ;Name is space padded.
   597                              <1> ;Input: rsi = ASCII string buffer
   598                              <1> ;       rdi = FCB name buffer
   599                              <1> ;Output: al = Char that terminated the source string 
   600 000045EB 53                  <1>     push rbx    
   601 000045EC 57                  <1>     push rdi
   602 000045ED B90B000000          <1>     mov ecx, 11
   603 000045F2 B020                <1>     mov al, " "
   604 000045F4 F3AA                <1>     rep stosb   ;Fill the buffer with spaces (so we don't need to fill later)
   605 000045F6 5F                  <1>     pop rdi
   606 000045F7 4889FB              <1>     mov rbx, rdi    ;Use rbx as the base pointer of this buffer
   607                              <1>     ;Preprocess for Dir Searches
   608 000045FA 803E2E              <1>     cmp byte [rsi], "."
   609 000045FD 7509                <1>     jne .processName
   610 000045FF A4                  <1>     movsb   ;Store the first dot
   611 00004600 803E2E              <1>     cmp byte [rsi], "."
   612 00004603 752C                <1>     jne .exitBadChar
   613 00004605 A4                  <1>     movsb
   614 00004606 EB29                <1>     jmp short .exitBadChar
   615                              <1> .processName:
   616 00004608 AC                  <1>     lodsb   ;Get the char in al
   617 00004609 84C0                <1>     test al, al ;If the char is a null, must be at the end of the name
   618 0000460B 7426                <1>     jz .exit
   619 0000460D 3C20                <1>     cmp al, " " ;If space or a period, go to extension field. If null, exit
   620 0000460F 7407                <1>     je .extSpace
   621 00004611 3C2E                <1>     cmp al, "."
   622 00004613 740C                <1>     je .ext
   623 00004615 AA                  <1>     stosb   ;Store the char
   624 00004616 EBF0                <1>     jmp short .processName
   625                              <1> .extSpace:
   626                              <1> ;Now we scan for a period in the name
   627 00004618 AC                  <1>     lodsb   ;Get a char and increase rsi
   628 00004619 84C0                <1>     test al, al
   629 0000461B 7416                <1>     jz .exit
   630 0000461D 3C2E                <1>     cmp al, "."     ;If al is not a period...
   631 0000461F 75F7                <1>     jne .extSpace   ; keep searching
   632                              <1> .ext:
   633 00004621 488D7B08            <1>     lea rdi, qword [rbx + filename.fExt]    ;Put destination at the extension
   634                              <1> .processExt:
   635 00004625 AC                  <1>     lodsb
   636 00004626 84C0                <1>     test al, al
   637 00004628 7409                <1>     jz .exit
   638 0000462A 3C20                <1>     cmp al, " "
   639 0000462C 7405                <1>     je .exit
   640 0000462E AA                  <1>     stosb
   641 0000462F EBF4                <1>     jmp short .processExt
   642                              <1> .exitBadChar:
   643 00004631 30C0                <1>     xor al, al  ;Return a null terminator
   644                              <1> .exit:
   645 00004633 5B                  <1>     pop rbx
   646                              <1>     return
    13                              <2> %%_ret:
    14 00004634 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   647                              <1> 
   648                              <1> findLastPathComponant:
   649                              <1> ;Finds the last path componant of an ASCIIZ path string
   650                              <1> ;Input: rdi -> Head of the path to find last componant on
   651                              <1> ;Output: rdi -> Start of the last componant
   652 00004635 50                  <1>     push rax
   653 00004636 51                  <1>     push rcx
   654 00004637 31C9                <1>     xor ecx, ecx
   655 00004639 FFC9                <1>     dec ecx
   656 0000463B 31C0                <1>     xor eax, eax
   657 0000463D F2AE                <1>     repne scasb ;Scan for the null terminator of the string
   658 0000463F F7D1                <1>     not ecx     ;This gets the count of chars  
   659 00004641 48FFCF              <1>     dec rdi     ;Move rdi back to the null!
   660 00004644 8A05C0B9FFFF        <1>     mov al, byte [pathSep]
   661 0000464A FD                  <1>     std
   662 0000464B F2AE                <1>     repne scasb ;Now scan backwards for the pathsep, or we run out of chars!
   663 0000464D FC                  <1>     cld
   664 0000464E 7503                <1>     jnz .exit   ;Ran out of chars to scan! Skip the extra inc
   665 00004650 48FFC7              <1>     inc rdi     ;Point at pathsep
   666                              <1> .exit:
   667 00004653 48FFC7              <1>     inc rdi     ;Point at char after pathsep or first char in buffer
   668 00004656 59                  <1>     pop rcx
   669 00004657 58                  <1>     pop rax
   670                              <1>     return
    13                              <2> %%_ret:
    14 00004658 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   671                              <1> 
   672                              <1> FCBToAsciiz:
   673                              <1> ;Converts a filename in the form FILENAMEEXT to FILENAME.EXT,0
   674                              <1> ;Name is space padded too
   675                              <1> ;Input: rsi = FCB name buffer
   676                              <1> ;       rdi = ASCIIZ string buffer
   677 00004659 B908000000          <1>     mov ecx, 8
   678 0000465E F3A4                <1>     rep movsb   ;Move the name over
   679                              <1> .scanNameSpace:
   680 00004660 807FFF20            <1>     cmp byte [rdi - 1], " " ;Is the previous char a space?
   681 00004664 750D                <1>     jne .ext
   682 00004666 48FFCF              <1>     dec rdi
   683 00004669 FFC1                <1>     inc ecx
   684 0000466B 81F908000000        <1>     cmp ecx, 8
   685 00004671 72ED                <1>     jb .scanNameSpace
   686                              <1> .ext:
   687 00004673 66813E2020          <1>     cmp word [rsi], "  "    ;Are the first two chars a space?
   688 00004678 7506                <1>     jne .validExt
   689 0000467A 807E0220            <1>     cmp byte [rsi + 2], " " ;Is the final char a space?
   690 0000467E 7415                <1>     je .exit
   691                              <1> .validExt:
   692 00004680 B02E                <1>     mov al, "." ;We have a valid extension, store a period
   693 00004682 AA                  <1>     stosb
   694 00004683 B903000000          <1>     mov ecx, 3
   695 00004688 F3A4                <1>     rep movsb   ;Move the three extension chars over
   696                              <1> .scanExtSpace:
   697 0000468A 807FFF20            <1>     cmp byte [rdi - 1], " " ;Is the previous char a space
   698 0000468E 7505                <1>     jne .exit
   699 00004690 48FFCF              <1>     dec rdi
   700 00004693 EBF5                <1>     jmp short .scanExtSpace
   701                              <1> .exit:
   702 00004695 31C0                <1>     xor eax, eax
   703 00004697 AA                  <1>     stosb   ;Store a null at the end
   704                              <1>     return
    13                              <2> %%_ret:
    14 00004698 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
