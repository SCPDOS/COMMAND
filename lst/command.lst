    50 00004B96 4887FE              <1>     xchg rdi, rsi   ;Swap the pointers
    51 00004B99 48A5                <1>     movsq   ;Move over the 11 chars :)
    52 00004B9B 66A5                <1>     movsw
    53 00004B9D A4                  <1>     movsb
