     3 00000000 ????                <1> returnCode  dw ?    ;Return Code from a child process
     4 00000002 ????????????????    <1> int2Epsp    dq ?    ;
     5 0000000A ????????????????    <1> int2Ersp    dq ?    ;Save the far Int 2E entry stack pointer!
     6 00000012 ????????????????    <1> int2Edta    dq ?    ;
     7                              <1> ;=============================================================
