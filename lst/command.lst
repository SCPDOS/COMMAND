   477                              <1> strcpy:
   478                              <1> ;Copies an ASCIIZ string but leaves the pointers at the end of the strings
   479                              <1> ;rsi -> Source
   480                              <1> ;rdi -> Destination
   481 00004540 51                  <1>     push rcx
   482 00004541 57                  <1>     push rdi
   483 00004542 4889F7              <1>     mov rdi, rsi
