  1053 000026E3 5E                  <1>     pop rsi     ;Get this ptr back
  1054 000026E4 B81E120000          <1>     mov eax, 121Eh  ;Cmpr ASCII strings
  1055 000026E9 CD2F                <1>     int 2Fh
  1056 000026EB 755C                <1>     jnz .notSameFile
  1057                              <1> ;Now we check if we are in a concat mode. 
  1058                              <1> ; If in Concat and we are on the first file, just move the file pointer 
  1059                              <1> ; to the end of the file and return.
  1060                              <1> ; If in Concat and we are not on the first file, print content of 
  1061                              <1> ; destination lost and return.
  1062                              <1> ; Else, exist bad.
  1063                              <1> ;Concat is defined as (mod3Cpy or wcSrc) and oneDest
  1064 000026ED 0FB605(55070000)    <1>     movzx eax, byte [bCpFlg]   ;Get the flags
  1065 000026F4 89C1                <1>     mov ecx, eax        ;Copy the flags
  1066 000026F6 81E110000000        <1>     and ecx, oneDest    ;Isolate for AND
  1067 000026FC 743C                <1>     jz .sameNameExit    ;If not set, not in Concat mode
  1068 000026FE 2588000000          <1>     and eax, mod3Cpy | wcSrc   ;Compute the OR
  1069 00002703 89C1                <1>     mov ecx, eax
  1070 00002705 2580000000          <1>     and eax, mod3Cpy    ;Save this bit
  1071 0000270A 81E108000000        <1>     and ecx, wcSrc      ;And this bit
  1072 00002710 09C8                <1>     or eax, ecx         ;Construct a single vale.
  1073 00002712 7426                <1>     jz .sameNameExit    ;If neither bit was set, we don't have condition.
  1074 00002714 488D15(93060000)    <1>     lea rdx, destSpec   ;Prepare rdx to the destination
  1075 0000271B F705(51070000)FFFF- <1>     test dword [dCpCnt], -1 ;Is this the first file?
  1075 00002723 FFFF                <1>
  1076 00002725 7506                <1>     jnz .notFirstLost   ;If not, we skip this file from copy!
  1077 00002727 E884010000          <1>     call .openFile      ;Moving the fp suffices for the copy
  1078                              <1>     return
