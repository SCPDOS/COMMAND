   591                              <1> asciiFilenameToFCB:
   592                              <1> ;Converts a filename in the form FILENAME.EXT,0 to FILENAMEEXT
   593                              <1> ;Don't uppercase any lowercase chars as this could be used with user buffers.
   594                              <1> ;Also doesn't check if chars are valid
   595                              <1> ;Names such as SYS.COM get converted to "SYS     COM"
   596                              <1> ;Name is space padded.
   597                              <1> ;Input: rsi = ASCII string buffer
   598                              <1> ;       rdi = FCB name buffer
   599                              <1> ;Output: al = Char that terminated the source string 
   600 000045BC 53                  <1>     push rbx    
   601 000045BD 57                  <1>     push rdi
   602 000045BE B90B000000          <1>     mov ecx, 11
   603 000045C3 B020                <1>     mov al, " "
   604 000045C5 F3AA                <1>     rep stosb   ;Fill the buffer with spaces (so we don't need to fill later)
   605 000045C7 5F                  <1>     pop rdi
   606 000045C8 4889FB              <1>     mov rbx, rdi    ;Use rbx as the base pointer of this buffer
   607                              <1>     ;Preprocess for Dir Searches
   608 000045CB 803E2E              <1>     cmp byte [rsi], "."
   609 000045CE 7509                <1>     jne .processName
   610 000045D0 A4                  <1>     movsb   ;Store the first dot
   611 000045D1 803E2E              <1>     cmp byte [rsi], "."
   612 000045D4 752C                <1>     jne .exitBadChar
   613 000045D6 A4                  <1>     movsb
   614 000045D7 EB29                <1>     jmp short .exitBadChar
   615                              <1> .processName:
   616 000045D9 AC                  <1>     lodsb   ;Get the char in al
   617 000045DA 84C0                <1>     test al, al ;If the char is a null, must be at the end of the name
   618 000045DC 7426                <1>     jz .exit
   619 000045DE 3C20                <1>     cmp al, " " ;If space or a period, go to extension field. If null, exit
   620 000045E0 7407                <1>     je .extSpace
   621 000045E2 3C2E                <1>     cmp al, "."
   622 000045E4 740C                <1>     je .ext
   623 000045E6 AA                  <1>     stosb   ;Store the char
   624 000045E7 EBF0                <1>     jmp short .processName
   625                              <1> .extSpace:
   626                              <1> ;Now we scan for a period in the name
   627 000045E9 AC                  <1>     lodsb   ;Get a char and increase rsi
   628 000045EA 84C0                <1>     test al, al
   629 000045EC 7416                <1>     jz .exit
   630 000045EE 3C2E                <1>     cmp al, "."     ;If al is not a period...
   631 000045F0 75F7                <1>     jne .extSpace   ; keep searching
   632                              <1> .ext:
   633 000045F2 488D7B08            <1>     lea rdi, qword [rbx + filename.fExt]    ;Put destination at the extension
   634                              <1> .processExt:
   635 000045F6 AC                  <1>     lodsb
   636 000045F7 84C0                <1>     test al, al
   637 000045F9 7409                <1>     jz .exit
   638 000045FB 3C20                <1>     cmp al, " "
   639 000045FD 7405                <1>     je .exit
   640 000045FF AA                  <1>     stosb
   641 00004600 EBF4                <1>     jmp short .processExt
   642                              <1> .exitBadChar:
   643 00004602 30C0                <1>     xor al, al  ;Return a null terminator
   644                              <1> .exit:
   645 00004604 5B                  <1>     pop rbx
   646                              <1>     return
    13                              <2> %%_ret:
    14 00004605 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   647                              <1> 
   648                              <1> findLastPathComponant:
   649                              <1> ;Finds the last path componant of an ASCIIZ path string
   650                              <1> ;Input: rdi -> Head of the path to find last componant on
   651                              <1> ;Output: rdi -> Start of the last componant
   652 00004606 50                  <1>     push rax
   653 00004607 51                  <1>     push rcx
   654 00004608 31C9                <1>     xor ecx, ecx
   655 0000460A FFC9                <1>     dec ecx
   656 0000460C 31C0                <1>     xor eax, eax
   657 0000460E F2AE                <1>     repne scasb ;Scan for the null terminator of the string
   658 00004610 F7D1                <1>     not ecx     ;This gets the count of chars  
   659 00004612 48FFCF              <1>     dec rdi     ;Move rdi back to the null!
   660 00004615 8A05EFB9FFFF        <1>     mov al, byte [pathSep]
   661 0000461B FD                  <1>     std
   662 0000461C F2AE                <1>     repne scasb ;Now scan backwards for the pathsep, or we run out of chars!
   663 0000461E FC                  <1>     cld
   664 0000461F 7503                <1>     jnz .exit   ;Ran out of chars to scan! Skip the extra inc
   665 00004621 48FFC7              <1>     inc rdi     ;Point at pathsep
   666                              <1> .exit:
   667 00004624 48FFC7              <1>     inc rdi     ;Point at char after pathsep or first char in buffer
   668 00004627 59                  <1>     pop rcx
   669 00004628 58                  <1>     pop rax
   670                              <1>     return
    13                              <2> %%_ret:
    14 00004629 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   671                              <1> 
   672                              <1> FCBToAsciiz:
   673                              <1> ;Converts a filename in the form FILENAMEEXT to FILENAME.EXT,0
   674                              <1> ;Name is space padded too
   675                              <1> ;Input: rsi = FCB name buffer
   676                              <1> ;       rdi = ASCIIZ string buffer
   677 0000462A B908000000          <1>     mov ecx, 8
   678 0000462F F3A4                <1>     rep movsb   ;Move the name over
   679                              <1> .scanNameSpace:
   680 00004631 807FFF20            <1>     cmp byte [rdi - 1], " " ;Is the previous char a space?
   681 00004635 750D                <1>     jne .ext
   682 00004637 48FFCF              <1>     dec rdi
   683 0000463A FFC1                <1>     inc ecx
   684 0000463C 81F908000000        <1>     cmp ecx, 8
   685 00004642 72ED                <1>     jb .scanNameSpace
   686                              <1> .ext:
   687 00004644 66813E2020          <1>     cmp word [rsi], "  "    ;Are the first two chars a space?
   688 00004649 7506                <1>     jne .validExt
   689 0000464B 807E0220            <1>     cmp byte [rsi + 2], " " ;Is the final char a space?
   690 0000464F 7415                <1>     je .exit
   691                              <1> .validExt:
   692 00004651 B02E                <1>     mov al, "." ;We have a valid extension, store a period
   693 00004653 AA                  <1>     stosb
   694 00004654 B903000000          <1>     mov ecx, 3
   695 00004659 F3A4                <1>     rep movsb   ;Move the three extension chars over
   696                              <1> .scanExtSpace:
   697 0000465B 807FFF20            <1>     cmp byte [rdi - 1], " " ;Is the previous char a space
   698 0000465F 7505                <1>     jne .exit
   699 00004661 48FFCF              <1>     dec rdi
   700 00004664 EBF5                <1>     jmp short .scanExtSpace
   701                              <1> .exit:
   702 00004666 31C0                <1>     xor eax, eax
   703 00004668 AA                  <1>     stosb   ;Store a null at the end
   704                              <1>     return
    13                              <2> %%_ret:
    14 00004669 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
