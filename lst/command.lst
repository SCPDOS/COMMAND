  1125 00004966 740C                <1>     jz .badExit
  1126 00004968 3807                <1>     cmp byte [rdi], al  ;Is char two null?
  1127 0000496A 75F6                <1>     jne .pathNulScan    ;If not, keep searching
  1128 0000496C 31C0                <1>     xor eax, eax
  1129 0000496E FFC0                <1>     inc eax ;Clear the ZF
  1130 00004970 498B703E            <1>     mov rsi, qword [r8 + psp.envPtr]    ;Return the env ptr here
