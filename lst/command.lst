   706                              <1> cpDelimOrCtrlStringToBufz:
   707                              <1> ;Copy a delimited or control char terminated string to a buffer
   708                              <1> ;Input: rsi -> Point to start of delimiter or ctrlchar terminated string
   709                              <1> ;       rdi -> Buffer to store null terminated string in
   710                              <1> ;Output: rsi -> First char past string end
   711                              <1> ;       rdi -> One char past null terminator on string buffer
   712 00004699 C60700              <1>     mov byte [rdi], 0   ;Init by null terminating
   713                              <1> .lp:
   714 0000469C AC                  <1>     lodsb
   715 0000469D 3C20                <1>     cmp al, 20h ;Chars up to 20h are delimiters here. CR included!
   716 0000469F 760A                <1>     jbe .exit
   717 000046A1 E8E6FEFFFF          <1>     call isALdelimiter
   718 000046A6 7403                <1>     je .exit
   719 000046A8 AA                  <1>     stosb
   720 000046A9 EBF1                <1>     jmp short .lp
   721                              <1> .exit:
   722 000046AB 31C0                <1>     xor eax, eax
   723 000046AD AA                  <1>     stosb   ;Store a null terminator
   724                              <1>     return
    13                              <2> %%_ret:
    14 000046AE C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
