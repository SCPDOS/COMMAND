  1702 00002E43 66813BCD30          <1>     cmp word [rbx], 30CDh
  1703 00002E48 7426                <1>     je .biosConfirmed
  1704 00002E4A 66813B48CF          <1>     cmp word [rbx], 0CF48h   ;CFh = IRET, 48h=REX.W
  1705 00002E4F 7407                <1>     je .doAnsi      ;If we hit an IRETQ, assume not BIOS
  1706 00002E51 48FFC3              <1>     inc rbx         ;Else, go to next byte for checking
  1707 00002E54 FFC9                <1>     dec ecx
