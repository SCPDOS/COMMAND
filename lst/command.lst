  1683                              <1> ;Else, we default to an ANSI code that might not work.
  1684 00002E0B B8001A0000          <1>     mov eax, 1A00h  ;Check if ANSI.SYS is hooked in.
  1685 00002E10 CD2F                <1>     int 2Fh
  1686 00002E12 3CFF                <1>     cmp al, -1
