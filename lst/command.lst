   727                              <1> cpDelimPathToBufz:
   728                              <1> ;Copy a delimited path into buffer and null terminate.
   729                              <1> ;Input: rsi -> Point to start of delimiter terminated path
   730                              <1> ;       rdi -> Buffer to store null terminated path in
   731                              <1> ;Output: rsi -> First char past pathname delimiter
   732                              <1> ;       rdi -> One char past null terminator on pathname buffer
   733 00004680 53                  <1>     push rbx
   734 00004681 4889FB              <1>     mov rbx, rdi    ;Save the head of the path in rbx
   735 00004684 C60700              <1>     mov byte [rdi], 0   ;Null terminate this path before starting!
   736                              <1> .lp:
   737 00004687 AC                  <1>     lodsb   ;Get the char
   738 00004688 3C0D                <1>     cmp al, CR
   739 0000468A 7412                <1>     je .gotRedirPath
   740 0000468C E8CCFEFFFF          <1>     call isALdelimiter  ;Is this char a delimiter char?
   741 00004691 740B                <1>     jz .gotRedirPath 
   742 00004693 3A0572B9FFFF        <1>     cmp al, byte [switchChar]
   743 00004699 7403                <1>     je .gotRedirPath
   744 0000469B AA                  <1>     stosb   ;Store this char and loop next char
   745 0000469C EBE9                <1>     jmp short .lp
   746                              <1> .gotRedirPath:
   747 0000469E 50                  <1>     push rax    ;Save the char on stack
   748 0000469F 30C0                <1>     xor al, al  ;Get null terminator char
   749 000046A1 4829FB              <1>     sub rbx, rdi
