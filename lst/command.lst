  1688 00002E16 B800440000          <1>     mov eax, 4400h  ;Get device info
  1689 00002E1B BB01000000          <1>     mov ebx, 1      ;for handle 1
  1690 00002E20 CD21                <1>     int 21h         ;in dx
  1691 00002E22 F7C280000000        <1>     test edx, devCharDev
  1692 00002E28 7429                <1>     jz .doAnsi  ;Make files register an ansi cls sequence
  1693 00002E2A F7C210000000        <1>     test edx, devCharFastOut
  1694 00002E30 7421                <1>     jz .doAnsi
  1695                              <1>     ;Test if Int 29h uses Int 30h
  1696                              <1>     ;Tests if within the first 1024 bytes we have the sequence Int 30h (30CD)
  1697                              <1>     ;Int 29h MUST be terminated with a IRETQ, within 1024 bytes
  1698 00002E32 B829350000          <1>     mov eax, 3529h  ;Get the vector for interrupt 29h
  1699 00002E37 CD21                <1>     int 21h
  1700 00002E39 B900040000          <1>     mov ecx, 1024   ;Check in a 1024 byte window for a Int 30h call
