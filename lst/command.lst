   727                              <1> cpDelimPathToBufz:
   728                              <1> ;Copy a delimited path into buffer and null terminate.
   729                              <1> ;Input: rsi -> Point to start of delimiter terminated path
   730                              <1> ;       rdi -> Buffer to store null terminated path in
   731                              <1> ;Output: rsi -> First char past pathname delimiter
   732                              <1> ;       rdi -> One char past null terminator on pathname buffer
   733 0000467B 53                  <1>     push rbx
   734 0000467C 4889FB              <1>     mov rbx, rdi    ;Save the head of the path in rbx
   735 0000467F C60700              <1>     mov byte [rdi], 0   ;Null terminate this path before starting!
   736                              <1> .lp:
   737 00004682 AC                  <1>     lodsb   ;Get the char
   738 00004683 3C0D                <1>     cmp al, CR
   739 00004685 7412                <1>     je .gotRedirPath
   740 00004687 E8CCFEFFFF          <1>     call isALdelimiter  ;Is this char a delimiter char?
   741 0000468C 740B                <1>     jz .gotRedirPath 
   742 0000468E 3A0577B9FFFF        <1>     cmp al, byte [switchChar]
   743 00004694 7403                <1>     je .gotRedirPath
   744 00004696 AA                  <1>     stosb   ;Store this char and loop next char
   745 00004697 EBE9                <1>     jmp short .lp
   746                              <1> .gotRedirPath:
   747 00004699 50                  <1>     push rax    ;Save the char on stack
   748 0000469A 30C0                <1>     xor al, al  ;Get null terminator char
   749 0000469C 4829FB              <1>     sub rbx, rdi
   750 0000469F 4881FBFFFFFFFF      <1>     cmp rbx, -1 ;This is because one char has been written!!
   751 000046A6 7412                <1>     je .notColon
   752 000046A8 4881FBFEFFFFFF      <1>     cmp rbx, -2 ;This is for drive letters, must always have the colon!!
   753 000046AF 7409                <1>     je .notColon
   754 000046B1 807FFF3A            <1>     cmp byte [rdi - 1], ":" ;Is this a colon?
