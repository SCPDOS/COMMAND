  1048 000026CD 57                  <1>     push rdi    ;Save this searchSpec
  1049 000026CE 488D35(93060000)    <1>     lea rsi, destSpec
  1050 000026D5 488D3D(F2040000)    <1>     lea rdi, searchSpec + cmdBufferL ;Use the latter half to store this bit
  1051 000026DC B800600000          <1>     mov eax, 6000h
