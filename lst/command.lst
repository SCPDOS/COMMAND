   872 0000477B 48F7F3              <1>     div rbx         ;Divide rax by 10
   873 0000477E 80C230              <1>     add dl, "0"     
   874 00004781 8817                <1>     mov byte [rdi], dl
   875 00004783 48FFC7              <1>     inc rdi
   876 00004786 FEC1                <1>     inc cl          ;Inc number of chars
   877 00004788 FEC5                <1>     inc ch          ;Inc to keep track of commas
   878 0000478A 4885C0              <1>     test rax, rax
   879 0000478D 75CC                <1>     jnz .lp
