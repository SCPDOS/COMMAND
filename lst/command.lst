   897                              <1> ; batchmode is on!
   898                              <1> ;
   899                              <1> ;Input: rsi points to the count byte of a command line.
   900                              <1> ;       Max number of chars is 128 (127 + count byte)
   901                              <1> ;Output:
   902                              <1> ;       CF=NC: Command was processed. ax = Retcode
