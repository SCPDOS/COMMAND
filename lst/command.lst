   413                              <1> hexToBCD:
   414                              <1> ;Converts a Hex byte into two BCD digits
   415                              <1> ;Takes input in al, returns in al (zero-ed upper seven bytes)
   416 000044E6 51                  <1>     push rcx
   417 000044E7 0FB6C0              <1>     movzx eax, al   ;Zero extend
   418 000044EA 31C9                <1>     xor ecx, ecx
   419                              <1> .htb0:
   420 000044EC 3D0A000000          <1>     cmp eax, 10
   421 000044F1 7209                <1>     jb .htb1
   422 000044F3 2D0A000000          <1>     sub eax, 10
   423 000044F8 FFC1                <1>     inc ecx
   424 000044FA EBF0                <1>     jmp short .htb0
   425                              <1> .htb1:
   426 000044FC C1E104              <1>     shl ecx, 4  ;Move to upper nybble
   427 000044FF 08C8                <1>     or al, cl   ;Move upper nybble into al upper nybble
   428 00004501 59                  <1>     pop rcx
   429 00004502 C3                  <1>     ret
   430                              <1> 
   431                              <1> printPackedBCD:
   432                              <1> ;Gets a packed BCD digit in al and prints al[7:4] if non zero,
   433                              <1> ; then prints al[3:0]. Prints a space if the upper nybble is zero
   434                              <1> ;Preserves all registers
   435 00004503 50                  <1>     push rax
   436 00004504 52                  <1>     push rdx
   437 00004505 88C4                <1>     mov ah, al
   438 00004507 240F                <1>     and al, 0Fh     ;Isolate lower nybble
   439 00004509 80E4F0              <1>     and ah, 0F0h    ;Isolate upper nybble
   440 0000450C 7508                <1>     jnz .upperNybble
   441 0000450E B220                <1>     mov dl, " "
   442 00004510 B402                <1>     mov ah, 02h
   443 00004512 CD21                <1>     int 21h
   444 00004514 EB0E                <1>     jmp short .lowerNybble
   445                              <1> .upperNybble:
   446 00004516 50                  <1>     push rax
   447 00004517 C0EC04              <1>     shr ah, 4
   448 0000451A 80C430              <1>     add ah, "0"  ;Convert to an ASCII digit
   449 0000451D 88E2                <1>     mov dl, ah
   450 0000451F B402                <1>     mov ah, 02h ;Print DL
   451 00004521 CD21                <1>     int 21h
   452 00004523 58                  <1>     pop rax
   453                              <1> .lowerNybble:
   454 00004524 0430                <1>     add al, "0"
   455 00004526 88C2                <1>     mov dl, al
   456 00004528 B402                <1>     mov ah, 02h ;Print DL
   457 0000452A CD21                <1>     int 21h
   458 0000452C 5A                  <1>     pop rdx
   459 0000452D 58                  <1>     pop rax
   460                              <1>     return
