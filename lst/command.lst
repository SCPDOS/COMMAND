   413                              <1> hexToBCD:
   414                              <1> ;Converts a Hex byte into two BCD digits
   415                              <1> ;Takes input in al, returns in al (zero-ed upper seven bytes)
   416 000044B2 51                  <1>     push rcx
   417 000044B3 0FB6C0              <1>     movzx eax, al   ;Zero extend
   418 000044B6 31C9                <1>     xor ecx, ecx
