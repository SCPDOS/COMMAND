  1674                              <1> cls:  
  1675                              <1> ;Start by checking multiplexer if ANSI.SYS is installed. If it is,
  1676                              <1> ; default to using it.
  1677                              <1> ;If not, check the device. If it supports Fast output (int 29h) AND 
  1678                              <1> ; within the first 1024 bytes of the int 29h vector is 
  1679                              <1> ; the instruction sequence:
  1680                              <1> ;  int 30h
  1681                              <1> ;  iretq
  1682                              <1> ; then we use int 30h directly.
  1683                              <1> ;Else, we default to an ANSI code that might not work.
  1684 00002E10 B8001A0000          <1>     mov eax, 1A00h  ;Check if ANSI.SYS is hooked in.
  1685 00002E15 CD2F                <1>     int 2Fh
  1686 00002E17 3CFF                <1>     cmp al, -1
  1687 00002E19 743D                <1>     je .doAnsi
  1688 00002E1B B800440000          <1>     mov eax, 4400h  ;Get device info
  1689 00002E20 BB01000000          <1>     mov ebx, 1      ;for handle 1
  1690 00002E25 CD21                <1>     int 21h         ;in dx
  1691 00002E27 F7C280000000        <1>     test edx, devCharDev
  1692 00002E2D 7429                <1>     jz .doAnsi  ;Make files register an ansi cls sequence
  1693 00002E2F F7C210000000        <1>     test edx, devCharFastOut
  1694 00002E35 7421                <1>     jz .doAnsi
  1695                              <1>     ;Test if Int 29h uses Int 30h
  1696                              <1>     ;Tests if within the first 1024 bytes we have the sequence Int 30h (30CD)
  1697                              <1>     ;Int 29h MUST be terminated with a IRETQ, within 1024 bytes
  1698 00002E37 B829350000          <1>     mov eax, 3529h  ;Get the vector for interrupt 29h
  1699 00002E3C CD21                <1>     int 21h
  1700 00002E3E B900040000          <1>     mov ecx, 1024   ;Check in a 1024 byte window for a Int 30h call
