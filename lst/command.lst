   706                              <1> cpDelimOrCtrlStringToBufz:
   707                              <1> ;Copy a delimited or control char terminated string to a buffer
   708                              <1> ;Input: rsi -> Point to start of delimiter or ctrlchar terminated string
   709                              <1> ;       rdi -> Buffer to store null terminated string in
   710                              <1> ;Output: rsi -> First char past string end
   711                              <1> ;       rdi -> One char past null terminator on string buffer
   712 0000466A C60700              <1>     mov byte [rdi], 0   ;Init by null terminating
   713                              <1> .lp:
   714 0000466D AC                  <1>     lodsb
   715 0000466E 3C20                <1>     cmp al, 20h ;Chars up to 20h are delimiters here. CR included!
   716 00004670 760A                <1>     jbe .exit
   717 00004672 E8E6FEFFFF          <1>     call isALdelimiter
   718 00004677 7403                <1>     je .exit
   719 00004679 AA                  <1>     stosb
   720 0000467A EBF1                <1>     jmp short .lp
   721                              <1> .exit:
   722 0000467C 31C0                <1>     xor eax, eax
   723 0000467E AA                  <1>     stosb   ;Store a null terminator
   724                              <1>     return
    13                              <2> %%_ret:
    14 0000467F C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
