  1055 000026EE CD2F                <1>     int 2Fh
  1056 000026F0 755C                <1>     jnz .notSameFile
  1057                              <1> ;Now we check if we are in a concat mode. 
  1058                              <1> ; If in Concat and we are on the first file, just move the file pointer 
  1059                              <1> ; to the end of the file and return.
  1060                              <1> ; If in Concat and we are not on the first file, print content of 
  1061                              <1> ; destination lost and return.
  1062                              <1> ; Else, exist bad.
  1063                              <1> ;Concat is defined as (mod3Cpy or wcSrc) and oneDest
  1064 000026F2 0FB605(55070000)    <1>     movzx eax, byte [bCpFlg]   ;Get the flags
  1065 000026F9 89C1                <1>     mov ecx, eax        ;Copy the flags
  1066 000026FB 81E110000000        <1>     and ecx, oneDest    ;Isolate for AND
  1067 00002701 743C                <1>     jz .sameNameExit    ;If not set, not in Concat mode
  1068 00002703 2588000000          <1>     and eax, mod3Cpy | wcSrc   ;Compute the OR
  1069 00002708 89C1                <1>     mov ecx, eax
  1070 0000270A 2580000000          <1>     and eax, mod3Cpy    ;Save this bit
  1071 0000270F 81E108000000        <1>     and ecx, wcSrc      ;And this bit
  1072 00002715 09C8                <1>     or eax, ecx         ;Construct a single vale.
  1073 00002717 7426                <1>     jz .sameNameExit    ;If neither bit was set, we don't have condition.
  1074 00002719 488D15(93060000)    <1>     lea rdx, destSpec   ;Prepare rdx to the destination
  1075 00002720 F705(51070000)FFFF- <1>     test dword [dCpCnt], -1 ;Is this the first file?
  1075 00002728 FFFF                <1>
  1076 0000272A 7506                <1>     jnz .notFirstLost   ;If not, we skip this file from copy!
  1077 0000272C E884010000          <1>     call .openFile      ;Moving the fp suffices for the copy
  1078                              <1>     return
