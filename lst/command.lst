   537                              <1> eF6     equ 40h ;F6 second byte
   538                              <1> eF7     equ 41h ;F7 second byte
   539                              <1> eCursL  equ 4Bh ;Cursor Left second byte
   540                              <1> eCursR  equ 4Dh ;Cursor Right second byte
   541                              <1> eIns    equ 52h ;Insert second byte
